# Maintainer: De Marco Tech <contato@demarcotech.com.br>

pkgname=gnome-cosmic-pop22
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial Pop COSMIC suite for GNOME Shell 48"
arch=('x86_64')
url="https://github.com/matheusdmlopes/gnome-cosmic-pop22"
license=('GPL-3.0-only' 'MPL-2.0' 'LGPL-2.1-only' 'LGPL-3.0-or-later' 'CC-BY-SA-4.0')
depends=(
    'gnome-shell>=48'
    'gnome-shell<49'
    'python>=3.10'
    'python-gobject'
    'libadwaita'
    'gtk4'
)
makedepends=(
    'gjs'
    'nodejs'
    'typescript'
    'rust'
    'glib2'
    'libxkbcommon'
    'meson'
    'sassc'
    'desktop-file-utils'
    'xorg-server-xvfb'
    'python'
    'uv'
)
provides=(
    'pop-cosmic'
    'cosmic-workspaces'
    'pop-settings'
)
source=("git+https://github.com/matheusdmlopes/gnome-cosmic-pop22.git")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    make build
}

check() {
    cd "$srcdir/$pkgname"
    make test
}

package() {
    cd "$srcdir/$pkgname"
    make install PREFIX=/usr DESTDIR="$pkgdir"
}
