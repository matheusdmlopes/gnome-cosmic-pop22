#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/gnome-cosmic-pop22

# The Python suite runs under uv, which is not packaged for Debian, so the
# package build validates only the static seams. `make test` covers all of
# them plus pytest for developers and CI.
override_dh_auto_test:
	$(MAKE) test-schemas test-syntax test-desktop
